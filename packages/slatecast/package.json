{
  "name": "@castkit/slatecast",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The browser-mode (Slatecast) SPA: a tiny Preact + signals client the CastKit server serves at /d/<id>. Renders live, optionally touch-interactive views on kiosk browsers (Chromium/WPE) with a <60 KB gz budget.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "storybook": "storybook dev -p 6007 --no-open",
    "build-storybook": "storybook build",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@castkit/shared": "workspace:*",
    "@charcuterie/logic": "^1.2.0",
    "@charcuterie/tokens": "^1.5.0",
    "@preact/signals": "^2.5.1",
    "@preact/signals-core": "^1.13.1",
    "preact": "^10.29.1"
  },
  "devDependencies": {
    "@charcuterie/server": "^0.2.0",
    "@preact/preset-vite": "^2.10.2",
    "@storybook/addon-docs": "^10",
    "@storybook/preact-vite": "^10",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/user-event": "^14.6.1",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3",
    "playwright": "^1.61.1",
    "storybook": "^10",
    "typescript": "^6.0.3",
    "vite": "^7.3.4",
    "vitest": "^4.1.10"
  }
}
