{
  "name": "@castkit/desktop",
  "productName": "CastKit",
  "version": "0.3.3",
  "private": true,
  "description": "The CastKit desktop app: an Electron shell that shows CastKit pages in windows that remember their display, fullscreen state, and zoom.",
  "license": "MIT",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron .",
    "package": "node scripts/build.mjs && electron-forge package",
    "make": "node scripts/build.mjs && electron-forge make",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/build.mjs && node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@charcuterie/logic": "^2.10.0",
    "@charcuterie/tokens": "^1.10.2",
    "@charcuterie/ui": "^4.24.0",
    "@charcuterie/vite-config": "^1.1.0",
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-deb": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron-forge/shared-types": "8.0.1",
    "@electron/fuses": "^2.1.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^44.7.0",
    "electron-installer-debian": "^4.0.0",
    "electron-squirrel-startup": "^1.0.1",
    "esbuild": "^0.28.1",
    "lucide-react": "^0.560.0",
    "playwright": "^1.61.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.2",
    "vitest": "^4.1.10",
    "zod": "^4.6.6"
  }
}
