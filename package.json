{
  "name": "castkit",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "bakeoff:render": "tsx scripts/bakeoff-render.ts",
    "bakeoff:dither": "tsx scripts/bakeoff-dither.ts",
    "bakeoff": "pnpm bakeoff:render && pnpm bakeoff:dither",
    "build": "node scripts/build-server.mjs",
    "dev": "pnpm --filter @castkit/web dev",
    "dev:server": "pnpm --filter @castkit/server dev",
    "storybook": "pnpm --filter @castkit/web storybook",
    "build:storybook": "pnpm --filter @castkit/web build-storybook",
    "storybook:slatecast": "pnpm --filter @castkit/slatecast storybook",
    "build:storybook:slatecast": "pnpm --filter @castkit/slatecast build-storybook",
    "start:prod": "pnpm --filter @castkit/server start:prod",
    "install-playwright-browser": "pnpm playwright install chromium --with-deps",
    "lint:biome-format": "biome check --write --unsafe",
    "lint:biome": "biome check",
    "lint:eslint-format": "eslint . --fix",
    "lint:eslint": "eslint .",
    "lint": "pnpm lint:biome-format && pnpm lint:eslint-format",
    "test": "vitest",
    "vrt:capture": "pnpm --filter @castkit/slatecast vrt:capture",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit && pnpm -r --parallel run typecheck"
  },
  "dependencies": {
    "@castkit/core": "workspace:*",
    "@castkit/render": "workspace:*",
    "@castkit/views": "workspace:*",
    "@resvg/resvg-js": "^2.6.2",
    "playwright": "^1.61.1",
    "react": "^19.2.7",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@charcuterie/biome-config": "^1.3.0",
    "@charcuterie/eslint-config": "^1.7.1",
    "@charcuterie/playwright-config": "^2.0.0",
    "@charcuterie/tsconfig": "^1.0.0",
    "@charcuterie/vitest-config": "^2.0.0",
    "@playwright/test": "^1.61.1",
    "@storybook/preact-vite": "^10.5.10",
    "@types/node": "^26.1.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.6.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.10",
    "@hono/node-server": "^2.0.6",
    "hono": "^4.12.27",
    "mqtt": "^5.15.1",
    "@types/react": "^19.2.17",
    "@castkit/sdk": "workspace:*",
    "@castkit/shared": "workspace:*"
  }
}
